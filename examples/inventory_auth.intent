language: en

use sqlite
use FastAPI
use authentication

app Inventory:
    data Product:
        name: text
        price: decimal
        stock: integer

    data Supplier:
        name: text
        city: text

    records Product:
        "Widget", 9.99, 12
        "Gadget", 24.50, 3
        "bolt", 0.35, 400

    records Supplier:
        "Acme", "Lima"
        "Bolts & Co", "Quito"

    expose Product as api

    page Welcome:
        heading "Inventory"
        text "Sign in to see the stock."
        sign in "Name" "Password" "Sign in" "Wrong name or password"

    page Products:
        heading "Products"
        table Product
        searchable by name
        sortable by price
        editable
        button "Add product" width 160px adds Product
        button "Suppliers" opens Suppliers
        button "Sign out" signs out
        heading "Notifications"
        notifications

    page Suppliers:
        heading "Suppliers"
        table Supplier
        button "Products" opens Products
        button "Sign out" signs out

    when Product.stock < 5:
        notify inventory_manager
